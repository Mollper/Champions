# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Site URL used for auth email redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only (never NEXT_PUBLIC_): background processing of catalog requests and the daily cron
SUPABASE_SECRET_KEY=sb_secret_...
CRON_SECRET=any-long-random-string

# Free AI: https://aistudio.google.com/apikey and https://console.groq.com/keys
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# UniRoute · .env.example
